# Optional template only. Copy values into your existing local .env.
SOLANA_CLUSTER=devnet
# Set SOLANA_HTTP_URL and SOLANA_WS_URL together for your chosen cluster.
# Never commit authenticated endpoint URLs.
MAX_FETCH_CONCURRENCY=8
# Shared across all workers and retries: 100ms = at most 10 starts/second.
RPC_REQUEST_INTERVAL_MS=100

# V13 freshness (milliseconds); legacy concurrency/pacing names remain accepted.
FETCH_CONCURRENCY=8
RPC_MIN_REQUEST_INTERVAL_MS=100
INPUT_QUEUE_CAPACITY=2000
MAX_FETCH_START_AGE_MS=5000
MAX_MOMENTUM_EVENT_AGE_MS=5000
